PORT=3000
# Comma-separated origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173,https://ashiqazydev.github.io

MOCK_ENABLED=true
AUTO_FALLBACK=false
AUTHORIZED_PROVIDER_ENABLED=false

META_TIMEOUT_MS=10000
SOURCE_TIMEOUT_MS=15000

# OpenSubtitles consumer API key (server-only)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=ANIMEAZY v1.0

# Optional Shikimori OAuth (public anime list/detail does not require these)
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
SHIKIMORI_USER_AGENT=ANIMEAZY Discovery Hub
