VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CALLBACK_URL=http://localhost:5173

# OpenSubtitles consumer API key (https://www.opensubtitles.com/en/consumers)
VITE_OPENSUBTITLES_API_KEY=

# Authorized streaming — public config only (no scraper endpoints / private keys)
# Future backend base, e.g. https://api.example.com
VITE_STREAMING_API_BASE=
# Development mock provider (public sample HLS/MP4). true|false
VITE_STREAM_MOCK_ENABLED=true
# Auto-fallback across enabled providers when no provider is pinned
VITE_STREAM_AUTO_FALLBACK=false
