VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CALLBACK_URL=http://localhost:5173

# Optional browser fallback — prefer server OPENSUBTITLES_API_KEY
VITE_OPENSUBTITLES_API_KEY=

# ANIMEAZY streaming/data API (required for Watch providers + server subtitles)
VITE_STREAMING_API_BASE=http://localhost:3000
